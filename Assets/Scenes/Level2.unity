  tutorialText: {fileID: 2048492375}
  steps:
  - message: Press <color=yellow>{Move:left}</color> and <color=yellow>{Move:right}</color>
      to move
    action: 0
  - message: press <color=yellow>{Jump}</color> to jump
    action: 1
  - message: '\n\npress <color=yellow>{ShootUp}</color>,  <color=yellow>{ShootDown}</color>, 
      <color=yellow>{ShootLeft}</color>,  <color=yellow>{ShootRight}</color> to shoot
      in that direction.


      Hold <color=yellow>{ShootDiagonal}</color> + <color=yellow>{ShootUp}</color>
      / <color=yellow>{ShootDown}</color> to shoot diagonally'
    action: 2
  - message: Press <color=yellow>{Weapon1}, {Weapon2}, {Weapon3}, {Weapon4}, {Weapon5}</color>
      to switch weapon to change inventory slot
    action: 3
  - message: Press <color=yellow>{Pause}</color> to pause
    action: 4
  fadeTime: 0.3
  delayBetween: 0.5
