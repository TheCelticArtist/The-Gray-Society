    action: 0
  - message: press <color=yellow>{Jump}</color> to jump
    action: 1
  - message: press the <color=yellow>{ShootUp}</color>,  <color=yellow>{ShooDown}</color>, 
      <color=yellow>{ShootLeft}</color>,  <color=yellow>{ShootRight}</color> to shoot
      in that direction
    action: 2
